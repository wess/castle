{
  "name": "castle",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "atlas": "github:wess/atlas#main"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "bun run --filter @castle/web dev",
    "dev:server": "bun run --filter @castle/server dev",
    "build": "bun run --filter @castle/web build && bun run --filter @castle/server build",
    "deploy": "bun run scripts/deploy.ts",
    "test": "bun test",
    "check": "bunx biome check packages/ apps/",
    "tidy": "bunx biome check --write packages/ apps/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
